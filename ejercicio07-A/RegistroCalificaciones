# 1. Definición de excepciones personalizadas
class CalificacionFueraDeRangoError(Exception):
    """Lanzada cuando la nota no está entre 0 y 100."""
    pass

class NombreInvalidoError(Exception):
    """Lanzada cuando el nombre contiene números."""
    pass

def pedir_entero(mensaje):
    """Asegura que la entrada sea un número entero."""
    while True:
        try:
            return int(input(mensaje))
        except ValueError:
            print("❌ Error: Debes ingresar un número entero para la calificación.")

# --- Programa Principal ---
print("=" * 50)
print("SISTEMA DE REGISTRO CON VALIDACIÓN DOBLE")
print("=" * 50)

total_registros = 0

while True:
    print(f"\n--- Registro #{total_registros + 1} ---")
    nombre_input = input("Nombre del estudiante (o 'salir'): ").strip()

    if nombre_input.lower() == 'salir':
        break

    try:
        # Validación del Nombre: comprobamos si hay dígitos
        if any(char.isdigit() for char in nombre_input):
            raise NombreInvalidoError(f"El nombre '{nombre_input}' no puede contener números.")
        
        if not nombre_input:
            raise NombreInvalidoError("El nombre no puede estar vacío.")

        # Validación de la Calificación
        nota = pedir_entero(f"Calificación de {nombre_input}: ")
        
        if nota < 0 or nota > 100:
            raise CalificacionFueraDeRangoError(f"La nota {nota} está fuera del rango 0-100.")

    except NombreInvalidoError as e:
        print(f"🚫 Error en Nombre: {e}")
    
    except CalificacionFueraDeRangoError as e:
        print(f"🚫 Error en Nota: {e}")

    else:
        # Si todo salió bien, guardamos el registro (simulado)
        print(f"✅ ¡Éxito! {nombre_input} ha sido registrado.")
        total_registros += 1

    finally:
        # Esto se muestra SIEMPRE al final de cada intento
        print(f"INFO: Estudiantes registrados en esta sesión: {total_registros}")

print("\n" + "=" * 50)
print("FIN DEL PROGRAMA. ¡Buen día!")
print("=" * 50)